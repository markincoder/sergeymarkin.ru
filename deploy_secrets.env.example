# Шаблон для деплоя на сервер (СКОПИРУЙТЕ В deploy_secrets.env И ЗАПОЛНИТЕ ЛОКАЛЬНО)
# Файл deploy_secrets.env добавлен в .gitignore и НИКОГДА не будет закоммичен в репозиторий!

# IP адрес или домен сервера
SERVER_HOST=your.server.ip

# Порт SSH (по умолчанию 22)
SERVER_PORT=22

# Имя пользователя на сервере (например, sergeymarkin или root)
SERVER_USER=sergeymarkin

# Путь к SSH-ключу на вашем компьютере (например: C:/Users/Sergey/.ssh/id_rsa или ~/.ssh/id_ed25519)
# Если вы используете SSH-ключ, укажите путь здесь:
SERVER_KEY_PATH=

# ИЛИ пароль SSH (если вход по паролю, а не по ключу):
SERVER_PASSWORD=

# Путь к каталогу Docker Compose на сервере (где лежит docker-compose.yml):
REMOTE_DOCKER_DIR=/home/sergeymarkin/docker

# Имя подпапки с репозиторием проекта внутри REMOTE_DOCKER_DIR (по умолчанию sergeymarkin):
REMOTE_PROJECT_SUBDIR=sergeymarkin
