# Скопируйте в .env и подставьте значения (файл .env не коммитьте в git).
#
# Только для docker compose из корня репозитория (Dockerfile рядом с compose): раскомментируйте
# SERGEYMARKIN_APP_DIR=.
# Если compose в ~/docker/, а проект в ~/docker/sergeymarkin/ — эту строку не нужна.

# OpenAI: RAG-чат на сайте и сборка FAISS-индекса (`python -m backend.build_index`). Без ключа — /api/chat не отвечает моделью.
OPENAI_API_KEY=

# Одна короткая строка тематики для RAG-чата (system prompt). Пусто — значение по умолчанию из config.py.
# CHAT_RAG_THEME_LINE=

# Порог L2 FAISS: если лучший фрагмент «дальше» — и классификатор темы скажет «да», чат уйдёт оператору в Telegram. Подберите под свой индекс.
# RAG_HANDOFF_L2_MAX=1.25

# Почта (SMTP): задайте MAIL_SERVER / порт под выбранного провайдера; приложение читает .env через python-dotenv (config.py).
#
# Яндекс: MAIL_SERVER=smtp.yandex.ru, пароль приложения в Яндекс ID → Безопасность.
#
# Gmail (Google Workspace или обычный @gmail.com):
# - MAIL_SERVER=smtp.gmail.com
# - MAIL_USERNAME = полный адрес отправителя (тот же аккаунт, для которого создан пароль приложения)
# - MAIL_PASSWORD = пароль приложения: аккаунт Google → Безопасность → двухэтапная аутентификация → Пароли приложений
#   (без 2FA пароли приложений не выдаются; обычный пароль Gmail в SMTP не подойдёт)
# - MAIL_FROM можно не указывать — будет как MAIL_USERNAME; MAIL_TO — куда слать уведомления (может быть любой ящик)
MAIL_SERVER=smtp.yandex.ru
MAIL_USERNAME=your_login@yandex.ru
MAIL_PASSWORD=
MAIL_TO=sergeymarkin@yandex.ru
# По умолчанию сначала пробуется порт 587, затем 465 (на VPS часто режут 465).
# Отключить двойную попытку и задать только один порт:
# MAIL_SMTP_DUAL_TRY=false
# MAIL_PORT=587
# MAIL_USE_SSL=false
# MAIL_SMTP_TIMEOUT=12
# По умолчанию почта идёт только по IPv4 (иначе в Docker часто errno 101 на IPv6)
# MAIL_SMTP_FORCE_IPV4=false

# Telegram: токен от @BotFather; TELEGRAM_CHAT_ID — id чата (личка с ботом, группа с добавленным ботом и т.д.).
# Ответы оператора на сайт идут через webhook: Telegram шлёт POST только на публичный HTTPS URL.
# Локально: поднимите туннель (ngrok, cloudflared и т.п.), например https://xxxx.ngrok.io → localhost:8000,
# затем setWebhook с url=https://xxxx.ngrok.io/api/telegram/webhook и secret_token=<TELEGRAM_WEBHOOK_SECRET>.
# На сервере: тот же путь с вашим доменом и валидным TLS.
# Оператору: «Ответить» на сообщение бота (или в тексте первой строки session: <uuid> из уведомления).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Супергруппа с включёнными темами (forum): id темы, иначе sendMessage с reply иногда возвращает 400.
# TELEGRAM_MESSAGE_THREAD_ID=
# TELEGRAM_WEBHOOK_SECRET=
# Страница с одного домена, API с другого (редко) — список через запятую для CORS (и задайте CHAT_API_BASE в шаблоне).
# CORS_ALLOW_ORIGINS=https://sergeymarkin.ru,https://www.sergeymarkin.ru
# Текст в чате на сайте после команды оператора завершить сессию: /end, /закрыть (см. уведомление в Telegram). Пусто — дефолт из config.py.
# OPERATOR_CHAT_CLOSURE_MESSAGE=
ADMIN_USERNAME=
ADMIN_PASSWORD=
